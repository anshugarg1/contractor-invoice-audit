# Copy this file to .env and fill in ONE provider. Never commit .env.

# Model, as "provider:model". Any chat model LangChain's init_chat_model supports works.
LLM_MODEL=groq:openai/gpt-oss-120b
# LLM_MODEL=google_genai:gemini-3.8-flash   (free tier: about 20 requests/day per model, too few for a full eval)
# LLM_MODEL=openai:gpt-4.1-mini
# LLM_MODEL=anthropic:claude-haiku-5-5
# LLM_MODEL=anthropic:claude-sonnet-5-5
# LLM_MODEL=anthropic:claude-opus-5-5
# LLM_MODEL=ollama:qwen2.5:7b              (pip install langchain-ollama; runs locally, no key)

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# LLM_TEMPERATURE=0                    (leave unset for models that reject it)
# LLM_STRUCTURED_METHOD=json_schema    (force native structured output instead of tool calling)

# Optional: Langfuse tracing. Tracing is off unless both keys are set.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
